# Force LF regardless of the checkout platform's core.autocrlf. Shell
# scripts run on Linux (the VPS) and break on a CRLF shebang line; systemd
# unit files are safest treated the same way.
*.sh text eol=lf
*.service text eol=lf
# Git hooks are executed as shell scripts and have no extension.
.githooks/* text eol=lf
