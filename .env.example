# ═══════════════════════════════════════════════════════
# v2 async rebuild (HONEYSHIELD_PROJECT.md) — used from Phase 1 onward
# ═══════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────
DATABASE_URL=                                                 # postgresql://user:pass@host:5432/honeyshield — prod (Postgres)
SQLITE_PATH=./data/honeyshield_dev.db                          # local dev (used when DATABASE_URL is empty)
DB_SSL_MODE=require                                            # require | verify-full — asyncpg defaults to "prefer" and would
                                                               # silently accept an unencrypted connection, so this is explicit
SKIP_SCHEMA_INIT=false                                         # true in prod: the least-privilege DB role can't run CREATE TABLE.
                                                               # Apply database/schema_postgres.sql once as the DB owner, then see
                                                               # database/grants_production.sql

# ── Supabase project metadata (only needed if DATABASE_URL points at Supabase) ──
# Get these from the Supabase dashboard: Settings -> API.
SUPABASE_PROJECT_URL=                                          # https://<project-ref>.supabase.co — used for the REST-exposure check in docs/SECRETS.md
SUPABASE_ANON_KEY=                                              # the `anon` `public` key — safe to be public by design, but keep out of git regardless
SUPABASE_ACCESS_TOKEN=                                          # Personal Access Token, ONLY if using the Supabase MCP server (.mcp.json).
                                                               # Account-scoped, not project-scoped — see docs/SECRETS.md before generating one.
                                                               # Not needed to run the app itself.

# ── Deployment (Option A: HTTP-only on a free PaaS) ──────
# See README "Future Work" for why only HTTP is deployed.
ENABLED_SERVICES=SSH,FTP,TELNET,HTTP                           # production sets this to: HTTP
# PORT=                                                        # injected by the PaaS; overrides the HTTP port below. Leave unset locally.
#
# NOTE: PYTHONIOENCODING=utf-8 must also be set, but as a REAL environment
# variable in the platform's config — not here. Python fixes stdout's encoding
# before dotenv ever runs, so a value in .env would be read too late to matter.
# Without it, the non-ASCII banner/status glyphs can crash startup when logs go
# to a pipe under a C/POSIX locale.

# ── Reverse-proxy client IP resolution ───────────────────
# MUST be true behind a PaaS load balancer: otherwise every attacker is recorded
# as the balancer's address and all enrichment/scoring/correlation is garbage.
# MUST stay false on direct exposure, where these headers are attacker-forged.
TRUST_PROXY_HEADERS=false                                      # production sets this to: true
TRUSTED_CLIENT_IP_HEADER=                                      # platform-set single-value header, if offered (e.g. cf-connecting-ip)
FORWARDED_IP_HEADER=x-forwarded-for                            # list-valued fallback; the trusted entry is counted from the RIGHT
TRUSTED_PROXY_HOPS=1                                           # 1 = bare PaaS. 2 = Cloudflare in front of the PaaS.
IGNORE_UNFORWARDED_CONNECTIONS=false                           # production: true. Drops platform health checks, which probe the
                                                               # instance directly (no forwarding header) and would otherwise be
                                                               # logged as attacker traffic. Enable only after confirming real
                                                               # requests do arrive with the header.

# ── Threat intel APIs ────────────────────────────────────
ABUSEIPDB_API_KEY=your_key_here
OTX_API_KEY=your_key_here
# ip-api.com needs no key

# ── AI analyst (phase 6 — Google Gemini, direct SDK call, no LangChain) ──
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-flash-latest

# ── Admin dashboard (Phase 4) ─────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=                                            # generate with argon2, never store the raw password here
SESSION_SECRET=

# ── Honeypot ports (change from defaults to reduce noise-only bot hits) ──
SSH_PORT=2222
FTP_PORT=2121
HTTP_PORT=8080
TELNET_PORT=2323

# ═══════════════════════════════════════════════════════
# v1 legacy (dashboard/auth) — still in use until ported in Phase 4
# ═══════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=INFO

# ── Dashboard ──────────────────────────────────────────
DASHBOARD_REFRESH_SECONDS=15
DASHBOARD_RATE_LIMIT=100

# ── Security ───────────────────────────────────────────
ENABLE_AUTHENTICATION=true
SESSION_TIMEOUT_HOURS=8
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true

# Encrypts the API key vault (security/api_keys.enc). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required outside of local development — never commit the real value.
API_KEY_ENCRYPTION_SECRET=

# ── Database ───────────────────────────────────────────
USE_PRODUCTION_DB=true
DB_POOL_SIZE=5
